<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 握杆：浅灰渐变，两端藏于配重块后 -->
    <path android:pathData="M38,50 h32 v8 h-32 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#F5F5F5"
                android:endColor="#C6C6C6"
                android:startX="54"
                android:startY="50"
                android:endX="54"
                android:endY="58" />
        </aapt:attr>
    </path>

    <!-- 握感纹路：两条极淡的竖线，小尺寸下自然消失 -->
    <path
        android:fillColor="#1F000000"
        android:pathData="M48,50 h2 v8 h-2 z M58,50 h2 v8 h-2 z" />

    <!-- 左配重块：圆角矩形 + 白灰渐变（立体感） -->
    <path android:pathData="M33,42 h4 a3,3 0 0 1 3,3 v18 a3,3 0 0 1 -3,3 h-4 a3,3 0 0 1 -3,-3 v-18 a3,3 0 0 1 3,-3 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#BDBDBD"
                android:startX="35"
                android:startY="42"
                android:endX="35"
                android:endY="66" />
        </aapt:attr>
    </path>

    <!-- 右配重块 -->
    <path android:pathData="M75,42 h-4 a3,3 0 0 0 -3,3 v18 a3,3 0 0 0 3,3 h4 a3,3 0 0 0 3,-3 v-18 a3,3 0 0 0 -3,-3 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startColor="#FFFFFF"
                android:endColor="#BDBDBD"
                android:startX="73"
                android:startY="42"
                android:endX="73"
                android:endY="66" />
        </aapt:attr>
    </path>

    <!-- 左端堵头：胶囊形，略深一档与主块区分 -->
    <path
        android:fillColor="#E3E3E3"
        android:pathData="M27.5,47 a2.5,2.5 0 0 1 2.5,2.5 v9 a2.5,2.5 0 0 1 -2.5,2.5 a2.5,2.5 0 0 1 -2.5,-2.5 v-9 a2.5,2.5 0 0 1 2.5,-2.5 z" />

    <!-- 右端堵头 -->
    <path
        android:fillColor="#E3E3E3"
        android:pathData="M80.5,47 a2.5,2.5 0 0 0 -2.5,2.5 v9 a2.5,2.5 0 0 0 2.5,2.5 a2.5,2.5 0 0 0 2.5,-2.5 v-9 a2.5,2.5 0 0 0 -2.5,-2.5 z" />
</vector>
